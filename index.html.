<script>
document.getElementById("year").textContent =
  new Date().getFullYear();

/* HOME / WORK NAVIGATION */

function showView(view) {
  const isHome = view === "home";

  document.getElementById("home-view").style.display =
    isHome ? "block" : "none";

  document.getElementById("work-view").style.display =
    isHome ? "none" : "block";

  document.getElementById("hero").style.display =
    isHome ? "grid" : "none";

  document.getElementById("home-tab").classList.toggle(
    "active", isHome
  );

  document.getElementById("work-tab").classList.toggle(
    "active", !isHome
  );

  history.replaceState(
    null,
    "",
    isHome ? "#home" : "#work"
  );

  window.scrollTo({
    top: 0,
    behavior: window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches ? "auto" : "smooth"
  });

  if (isHome) {
    document.querySelectorAll(".reveal").forEach(card => {
      card.classList.remove("show");
      observer.observe(card);
    });
  }
}

/* SCROLL REVEAL ANIMATION */

const observer = new IntersectionObserver(entries => {
  entries.forEach((entry, index) => {
    if (entry.isIntersecting) {
      entry.target.style.transitionDelay =
        Math.min(index * 80, 240) + "ms";

      entry.target.classList.add("show");
      observer.unobserve(entry.target);
    }
  });
}, {
  threshold: 0.12
});

document.querySelectorAll(".reveal").forEach(card => {
  observer.observe(card);
});

/* OPEN WORK WHEN URL ENDS WITH #work */

if (window.location.hash === "#work") {
  showView("work");
}
</script>

